<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="NoIndicatorBottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="android:minHeight">70dp</item>
        <item name="itemIconSize">28dp</item>
    </style>

    <style name="ToolbarTitleStyle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="SearchCategoryChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:textColor">#C0CEC5</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_search_chip</item>
    </style>

    <style name="SearchKeywordChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">9dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">#B8C7BD</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/bg_search_chip</item>
    </style>

    <style name="SearchRecentItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#B8C7BD</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="ProfileSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">25dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textColor">#00D68F</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
    </style>
</resources>