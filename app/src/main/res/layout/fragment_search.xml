<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101613"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:letterSpacing="0.12"
                android:text="KHÁM PHÁ SỰ KIỆN"
                android:textColor="#00D68F"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:lineSpacingExtra="2dp"
                android:text="Bạn muốn đi đâu \nhôm nay?"
                android:textColor="#FFFFFF"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="Tìm kiếm và khám phá những sự kiện thú vị dành cho bạn."
                android:textColor="#91A097"
                android:textSize="13sp" />

            <!-- Search box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_search_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Tìm kiếm"
                    android:src="@drawable/ic_search"
                    app:tint="#00D68F" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Tên sự kiện, nghệ sĩ..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#819087"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnClearSearch"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Xóa nội dung tìm kiếm"
                    android:gravity="center"
                    android:text="×"
                    android:textColor="#A8B6AD"
                    android:textSize="24sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Explore content -->
            <LinearLayout
                android:id="@+id/layoutExplore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Categories -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Danh mục"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khám phá tất cả"
                        android:textColor="#00D68F"
                        android:textSize="11sp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipMusic"
                            style="@style/SearchCategoryChip"
                            android:background="@drawable/bg_search_chip_selected"
                            android:text="♫  Âm nhạc"
                            android:textColor="#101613" />

                        <TextView
                            android:id="@+id/chipSport"
                            style="@style/SearchCategoryChip"
                            android:text="⚽  Thể thao" />

                        <TextView
                            android:id="@+id/chipWorkshop"
                            style="@style/SearchCategoryChip"
                            android:text="✦  Workshop" />

                        <TextView
                            android:id="@+id/chipFestival"
                            style="@style/SearchCategoryChip"
                            android:text="✧  Lễ hội" />

                        <TextView
                            android:id="@+id/chipOther"
                            style="@style/SearchCategoryChip"
                            android:text="▣  Khác" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Popular keywords -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="29dp"
                    android:text="Từ khóa phổ biến"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />


                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/keywordConcert"
                            style="@style/SearchKeywordChip"
                            android:text="# Concert" />

                        <TextView
                            android:id="@+id/keywordEDM"
                            style="@style/SearchKeywordChip"
                            android:text="# EDM Festival" />

                        <TextView
                            android:id="@+id/keywordAcoustic"
                            style="@style/SearchKeywordChip"
                            android:text="# Acoustic" />

                        <TextView
                            android:id="@+id/keywordFootball"
                            style="@style/SearchKeywordChip"
                            android:text="# Bóng đá" />

                        <TextView
                            android:id="@+id/keywordWorkshop"
                            style="@style/SearchKeywordChip"
                            android:text="# Workshop" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Recent searches -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tìm kiếm gần đây"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnClearHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xóa tất cả"
                        android:textColor="#00D68F"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutRecentSearches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/recentSearch1"
                        style="@style/SearchRecentItem"
                        android:text="◷  Concert Hà Nội" />

                    <TextView
                        android:id="@+id/recentSearch2"
                        style="@style/SearchRecentItem"
                        android:text="◷  Nhạc hội mùa hè" />

                    <TextView
                        android:id="@+id/recentSearch3"
                        style="@style/SearchRecentItem"
                        android:text="◷  Sự kiện cuối tuần" />

                </LinearLayout>

                <!-- Featured banner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_search_featured"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="ĐỪNG BỎ LỠ"
                        android:textColor="#00E6A0"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Trải nghiệm những\\nkhoảnh khắc đáng nhớ"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Tìm sự kiện yêu thích và đặt vé ngay hôm nay."
                        android:textColor="#C2D0C7"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Search results -->
            <LinearLayout
                android:id="@+id/layoutSearchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSearchResultTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="Kết quả tìm kiếm"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSearchResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <LinearLayout
                    android:id="@+id/layoutNoSearchResult"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:contentDescription="Không tìm thấy kết quả"
                        android:src="@drawable/ic_search"
                        app:tint="#64766A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="Không tìm thấy sự kiện"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center"
                        android:text="Thử tìm với từ khóa khác nhé!"
                        android:textColor="#8B9B92"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
