<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101613"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <TextView
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="CÀI ĐẶT"
            android:textColor="#00D68F"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Thiết lập tài khoản"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Quản lý tài khoản và tùy chỉnh trải nghiệm của bạn"
            android:textColor="#91A198"
            android:textSize="13sp" />

        <!-- Profile card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_profile_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_profile_avatar"
                android:gravity="center"
                android:text="Q"
                android:textColor="#101613"
                android:textSize="23sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quỳnh Lê Thị"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="quynh@example.com"
                    android:textColor="#91A198"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#00D68F"
                android:textSize="28sp" />
        </LinearLayout>

        <!-- General -->
        <TextView
            style="@style/ProfileSectionTitle"
            android:text="TÀI KHOẢN" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">

            <include
                android:id="@+id/itemEditProfile"
                layout="@layout/item_profile_setting"
                android:tag="edit_profile" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2A3930" />

            <include
                android:id="@+id/itemChangePassword"
                layout="@layout/item_profile_setting"
                android:tag="change_password" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2A3930" />

            <include
                android:id="@+id/itemPayment"
                layout="@layout/item_profile_setting"
                android:tag="payment" />
        </LinearLayout>

        <!-- Preferences -->
        <TextView
            style="@style/ProfileSectionTitle"
            android:text="TÙY CHỈNH" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">

            <include
                android:id="@+id/itemNotification"
                layout="@layout/item_profile_setting"
                android:tag="notification" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2A3930" />

            <include
                android:id="@+id/itemLanguage"
                layout="@layout/item_profile_setting"
                android:tag="language" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2A3930" />

            <include
                android:id="@+id/itemPrivacy"
                layout="@layout/item_profile_setting"
                android:tag="privacy" />
        </LinearLayout>

        <!-- Support -->
        <TextView
            style="@style/ProfileSectionTitle"
            android:text="HỖ TRỢ" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">

            <include
                android:id="@+id/itemHelp"
                layout="@layout/item_profile_setting"
                android:tag="help" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2A3930" />

            <include
                android:id="@+id/itemAbout"
                layout="@layout/item_profile_setting"
                android:tag="about" />
        </LinearLayout>

        <!-- Logout -->
        <TextView
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_profile_logout"
            android:gravity="center"
            android:text="Đăng xuất"
            android:textColor="#FF7777"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="TicketApp • Phiên bản 1.0.0"
            android:textColor="#637269"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
