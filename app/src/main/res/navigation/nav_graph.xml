<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/mainBottomTabFragment"
        android:name="com.example.musicapp.presentation.bottomtab.MainBottomTabFragment"
        android:label="MainBottomTabFragment" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.musicapp.presentation.auth.LoginFragment"
        android:label="LoginFragment">

        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />

        <action
            android:id="@+id/action_loginFragment_to_mainBottomTabFragment"
            app:destination="@id/mainBottomTabFragment" />

    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.musicapp.presentation.auth.RegisterFragment"
        android:label="RegisterFragment">

        <action
            android:id="@+id/action_registerFragment_to_verifyEmail"
            app:destination="@id/verifyEmail" />
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />

    </fragment>

    <fragment
        android:id="@+id/verifyEmail"
        android:name="com.example.musicapp.presentation.auth.VerifyEmail"
        android:label="VerifyEmail" >
        <action
            android:id="@+id/action_verifyEmail_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

</navigation>