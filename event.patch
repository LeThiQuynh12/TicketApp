-            if (mp != null && mp.isPlaying) {
-                emit(mp.currentPosition)
-            }
-            delay(intervalMs)
-        }
-    }
-
-    fun progressPercentFlow(intervalMs: Long = 500L): Flow<Int> = flow {
-        while (true) {
